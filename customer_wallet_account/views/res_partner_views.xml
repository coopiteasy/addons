<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">customer_wallet_account.view_partner_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']/group" position="inside">
                <group string="Customer Wallet" priority="99" name="customer_wallet">
                    <field name="customer_wallet_balance" widget="monetary" />
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter" model="ir.ui.view">
        <field name="name">customer_wallet_account.partner.search.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">
            <xpath expr="filter[last()]" position="after">
                <separator />
                <filter
                    name="customer_wallet_balance_nonzero"
                    string="Customer Wallet Balance Not Zero"
                    domain="[('customer_wallet_balance', '!=', 0)]"
                />
                <separator />
                <filter
                    name="company_and_individual"
                    string="Distinct Customer Wallets"
                    domain="[('parent_id', '=', False)]"
                />
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_tree" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="vat" position="after">
                <field name="customer_wallet_balance" sum="Total" />
            </field>
        </field>
    </record>

    <record id="action_res_partner_wallet" model="ir.actions.act_window">
        <field name="name">Customer Wallets</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_res_partner_tree" />
        <field name="context">{
            'search_default_customer_wallet_balance_nonzero': 1,
            'search_default_company_and_individual': 1,
            'active_test': False,
            }
        </field>
    </record>

    <menuitem
        id="menu_res_partner_wallet"
        parent="account.menu_finance_receivables"
        action="action_res_partner_wallet"
        sequence="120"
    />

</odoo>
