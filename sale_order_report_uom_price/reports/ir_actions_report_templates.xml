<odoo>
<template id="report_saleorder_document" inherit_id="sale.report_saleorder_document">

    <!-- Change Unit Price to Box Price -->
    <xpath expr="//th[@name='th_priceunit']" position="attributes">
        <attribute name="t-if">False</attribute>
    </xpath>
    <xpath expr="//th[@name='th_priceunit']" position="after">
        <th name="th_priceunit" class="text-end">Box Price</th>
    </xpath>


    <!-- Add base_unit_price as Price per kg/Unit -->
    <xpath expr="//th[@name='th_quantity']" position="after">
        <th name="th_base_unit_price" class="text-end">Price per kg/Unit</th>
    </xpath>
    <xpath expr="//td[@name='td_quantity']" position="after">
        <td name="td_base_unit_price" class="text-end">
            <t t-set="pricelist" t-value="doc.pricelist_id" />
            <t
                    t-set="combination_info"
                    t-value="line.product_id._get_combination_info_variant(
                    add_qty=1,
                    pricelist=pricelist,
                )"
                />
            <span
                    t-esc="combination_info['price'] / line.product_id.base_unit_count"
                    t-options="{'widget': 'monetary', 'display_currency': pricelist.currency_id}"
                />
            / <span t-field="line.product_id.base_unit_name" />
        </td>
    </xpath>

</template>
</odoo>
