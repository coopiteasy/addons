<odoo>
    <record id="product_template_form_contract_view" model="ir.ui.view">
        <field name="name">account.invoice.select.contract</field>
        <field name="model">product.template</field>
        <field
            name="inherit_id"
            ref="product_contract.product_template_form_contract_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_contract']/.." position="attributes">
                <attribute name="attrs">{'invisible': False}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
