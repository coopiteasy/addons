msgid ""
"There is not enough balance in the customer's wallet to perform this "
"payment. \n"
" - Customer : %(partner)s\n"
" - Customer Wallet : %(balance)s\n"
" - Amount Payment : %(amount)s"
msgstr ""
"Il n'y a pas assez d'argent sur le compte client de ce partenaire, pour "
"valider ce paiement. \n"
" - Client : %(partner)s\n"
" - Solde du compte client : %(balance)s\n"
" - Montant du paiement : %(amount)s"

