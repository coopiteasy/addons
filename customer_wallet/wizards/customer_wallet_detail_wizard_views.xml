<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_customer_wallet_detail_wizard_form" model="ir.ui.view">
        <field name="model">customer.wallet.detail.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                      <field name="partner_id" />
                      <field name="currency_id" invisible="1" />
                      <field
                        name="customer_wallet_balance"
                        widget="monetary"
                        options="{'currency_field': 'currency_id'}"
                    />
                    <field name="detail" widget="html" />
                </group>
            </form>
        </field>
    </record>

</odoo>
