<?xml version="1.0" ?>
<odoo>
    <record model="ir.ui.view" id="view_global_member_tree">
        <field name="name">res.partner.global.tree</field>
        <field name="model">res.partner.global</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="company_id" />
                <field name="membership_category_ids" widget="many2many_tags" />
                <field
                    name="membership_state"
                    optional="show"
                    decoration-info="membership_state =='waiting'"
                    decoration-success="membership_state in ['invoiced', 'free', 'paid']"
                    widget="badge"
                />
                <field name="membership_start" />
                <field name="membership_stop" />
            </tree>
        </field>
    </record>
</odoo>
