<odoo>

    <record model="ir.ui.view" id="view_company_form">
        <field name="name">res.company.form.board_representative</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <group name="social_media" position="before">
                <group name="board_representative_grp" string="Board Representative">
                    <field name="board_representative" />
                    <field name="board_representative_function" />
                    <field name="board_representative_signature_scan" />
                </group>
            </group>
        </field>
    </record>

</odoo>
