<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="fsm_order_form" model="ir.ui.view">
        <field name="name">fsm.order.form.inherit</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet//field[@name='priority']" position="after">
                <span
                    class="o_form_label o_td_label o_address_type"
                    name="address_name"
                >
                    <span>Address</span>
                </span>
                <div class="o_address_format" name="div_address">
                    <field
                        name="location_street"
                        placeholder="Street..."
                        class="o_address_street"
                    />
                    <field
                        name="location_street2"
                        placeholder="Street 2..."
                        class="o_address_street"
                    />
                    <field
                        name="location_city"
                        placeholder="City"
                        class="o_address_city"
                    />
                    <field
                        name="location_state_id"
                        class="o_address_state"
                        placeholder="State"
                        options="{'no_open': True, 'no_quick_create': True}"
                        context="{'country_id': location_country_id, 'default_country_id': location_country_id, 'zip': location_zip}"
                    />
                    <field
                        name="location_zip"
                        placeholder="ZIP"
                        class="o_address_zip"
                    />
                    <field
                        name="location_country_id"
                        placeholder="Country"
                        class="o_address_country"
                        options='{"no_open": True, "no_create": True}'
                    />
                </div>
            </xpath>
            <xpath expr="//sheet//field[@name='company_id']" position="after">
                <field name="social_beneficiary_partner_id" />
                <field name="social_partner_partner_id" />
            </xpath>
        </field>
    </record>
</odoo>
