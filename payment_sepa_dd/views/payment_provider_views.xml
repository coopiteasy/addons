<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">payment.provider.form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="account_payment.payment_provider_form" />
        <field name="arch" type="xml">
            <field name="cancel_msg" position="after">
                <field
                    name="sepa_dd_terms"
                    attrs="{'invisible': [('code', '!=', 'sepa_dd')]}"
                />
            </field>
            <group name="payment_followup" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('code', '=', 'sepa_dd')]}
                </attribute>
            </group>
            <field name="journal_id" position="attributes">
                <attribute name="attrs">
                    {'required': [('state', '!=', 'disabled'), ('code', 'not in', ['none', 'custom', 'sepa_dd'])]}
                </attribute>
            </field>
        </field>
    </record>

</odoo>
