<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">customer_wallet.view_partner_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.partner_view_buttons" />
        <field name="arch" type="xml">

            <button name="action_view_partner_invoices" position="after">
                <button
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    name="action_view_customer_wallet_details"
                >
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_value">
                            <field
                                name="customer_wallet_balance"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                            />
                        </span>
                        <span class="o_stat_text">Wallet</span>
                    </div>
                </button>
            </button>
        </field>
    </record>

    <record id="view_res_partner_filter" model="ir.ui.view">
        <field name="name">customer_wallet.partner.search.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">
            <xpath expr="filter[last()]" position="after">
                <filter
                    name="customer_wallet_balance_nonzero"
                    string="Customer Wallet Balance Not Zero"
                    domain="[('customer_wallet_balance', '!=', 0)]"
                />
                <separator />
                <filter
                    name="company_and_individual"
                    string="Distinct Customer Wallets"
                    domain="[('parent_id', '=', False)]"
                />
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_tree" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="import">0</attribute>
            </xpath>
            <field name="vat" position="after">
                <field name="has_customer_wallet" invisible="1" />
                <field
                    name="customer_wallet_balance"
                    sum="Total"
                    attrs="{'invisible': [('has_customer_wallet', '=', False)]}"
                />
                <button
                    type="object"
                    name="action_view_customer_wallet_details"
                    string="Details"
                    class="btn-secondary"
                    attrs="{'invisible': [('has_customer_wallet', '=', False)]}"
                />
                <button
                    type="object"
                    name="action_view_customer_wallet_redistribute"
                    string="Redistribute"
                    class="btn-secondary"
                    attrs="{'invisible': [('customer_wallet_balance', '&lt;=', 0.0)]}"
                />
            </field>
        </field>
    </record>

    <record id="action_res_partner_wallet" model="ir.actions.act_window">
        <field name="name">Customer Wallets</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,kanban,form,activity</field>
        <field name="view_id" ref="view_res_partner_tree" />
        <field name="context">{
            'search_default_company_and_individual': 1,
            'search_default_customer_wallet_balance_nonzero': 1,
            'active_test': False,
            }
        </field>
    </record>

    <menuitem
        id="menu_res_partner_wallet"
        parent="account.menu_finance_receivables"
        action="action_res_partner_wallet"
        sequence="120"
    />

</odoo>
