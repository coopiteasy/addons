                        <t t-foreach="range(5)" t-as="c">
                            <div class="col width-5 height-13 label">
                                <t
                                    t-if="l*5+c &lt; len(docs)"
                                    t-call="product_label_report.product_label_content_barcode_and_name"
                                >
                                    <t t-set="product" t-value="docs[l*5+c]" />
                                </t>
                            </div>
                        </t>
                    </div>
                </t>

            </div>
        </t>
    </template>

