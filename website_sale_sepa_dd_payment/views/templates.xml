<?xml version="1.0" encoding="utf-8" ?>
<odoo>

  <template id="sepa_debit_subscription_payment" inherit_id="website_sale.payment">
      <xpath expr="//t[@name='website_sale_non_free_cart']" position="before">

        <div id="payment_method_sepa_dd" class="mt-3">
          <h3 class="mb24">Pay by SEPA Direct Debit</h3>
          <div t-if="website_sale_order.allow_sepa_dd_payment">
            <form name="pay_by_sepa_dd" action="/shop/payment" method="post">
              <input
                            type="hidden"
                            name="csrf_token"
                            t-att-value="request.csrf_token()"
                            t-nocache="The csrf token must always be up to date."
                        />

              <div
                            t-foreach="sepa_dd_errors"
                            t-as="error"
                            class="alert alert-danger"
                            role="alert"
                        >
                <t t-out="error" />
              </div>

              <div class="mb-3">
                <label for="sepa-dd-iban" class="form-label">IBAN</label>
                <input
                                type="text"
                                class="form-control"
                                name="sepa-dd-iban"
                                id="sepa-dd-iban"
                                required="required"
                                t-att-value="sepa_dd_iban"
                            />
              </div>

              <div class="form-check mb-3">
                <input
                                class="form-check-input"
                                type="checkbox"
                                name="sign-sepa-dd"
                                value="sign_sepa_dd"
                                id="sign-sepa-dd"
                                required="required"
                            />
                <label class="form-check-label" for="sign-sepa-dd">
                  SEPA Direct Debit Conditions
                </label>
              </div>

              <div class="float-end mt-2">
                  <button type="submit" class="btn btn-primary">
                    Pay by SEPA Direct Debit <span class="fa fa-chevron-right" />
                  </button>
              </div>
            </form>
          </div>
          <div t-else="" class="alert alert-info">
            Payment by SEPA Direct Debit is not allowed for all the product in your order.
          </div>
          <div class="clearfix" />
        </div>

      </xpath>

      <xpath expr="//form[@name='o_wsale_confirm_order']" position="attributes">
        <attribute name="t-if">not website_sale_order.allow_sepa_dd_payment</attribute>
      </xpath>
  </template>

</odoo>
