<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_customer_wallet_redistribute_wizard_form" model="ir.ui.view">
        <field name="model">customer.wallet.redistribute.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="partner_id" />
                    <field name="currency_id" invisible="1" />
                    <field
                        name="customer_wallet_balance"
                        widget="monetary"
                        options="{'currency_field': 'currency_id'}"
                    />
                    <field name="amount" />
                    <field name="line_ids" string="Beneficiaries">
                        <tree editable="bottom">
                            <field name="partner_id" />
                            <field name="amount" sum="Total" />
                            <field name="currency_id" invisible="1" />
                        </tree>
                    </field>
                </group>
                <footer>
                    <button
                        name="button_redistribute"
                        string="Redistribute"
                        type="object"
                        class="oe_highlight"
                    />
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
