<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="paperformat_a4_nomargin" model="report.paperformat">
        <field name="name">European A4 no margin</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="product_template_label_repeat_8x3" model="ir.actions.report">
        <field name="name">Same Product Labels 8x3</field>
        <field name="model">product.template</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="paperformat_a4_nomargin" />
        <field
            name="report_name"
        >product_label_report.report_same_product_label_8x3</field>
        <field name="report_file">product_label_report.same_product_label</field>
        <field name="binding_model_id" ref="product.model_product_template" />
        <field name="binding_type">report</field>
    </record>

