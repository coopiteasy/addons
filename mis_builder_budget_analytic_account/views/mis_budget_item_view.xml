<odoo>
    <record model="ir.ui.view" id="mis_budget_item_tree_view">
        <field
            name="name"
        >mis.budget.item.tree (in mis_builder_budget_analytic_account)</field>
        <field name="model">mis.budget.item</field>
        <field name="inherit_id" ref="mis_builder_budget.mis_budget_item_tree_view" />
        <field name="arch" type="xml">
            <field name="amount" position="after">
                <field
                    name="analytic_account_id"
                    groups="analytic.group_analytic_accounting"
                />
            </field>
        </field>
    </record>
</odoo>
