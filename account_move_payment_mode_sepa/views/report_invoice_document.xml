<odoo>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document">
            <xpath expr="//div[@name='payment_term']" position="before">
                <div t-field="o.payment_mode_id" name="payment_mode" />
            </xpath>
            <xpath expr="//p[@name='payment_communication']" position="attributes">
                <attribute
                name="t-if"
            >o.move_type in ('out_invoice', 'in_refund') and o.payment_reference and not o.is_sepa_payment</attribute>
            </xpath>
    </template>
</odoo>
