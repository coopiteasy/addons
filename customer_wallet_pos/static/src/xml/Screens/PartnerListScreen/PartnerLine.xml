<templates id="template" xml:space="preserve">

    <t
        t-name="PartnerLine"
        t-inherit="point_of_sale.PartnerLine"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//button[hasclass('edit-partner-button')]/.." position="before">
            <td
                class="partner-line-wallet"
                t-if="env.pos.config.is_enabled_customer_wallet"
            >
                <span t-if="props.partner.customer_wallet_balance != '0'">
                    <t
                        t-esc="env.pos.format_currency(props.partner.customer_wallet_balance)"
                    />
                </span>
            </td>
        </xpath>

    </t>

</templates>
