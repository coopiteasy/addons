<?xml version="1.0" encoding="utf-8" ?>
<odoo>

  <template id="sepa_debit_subscriptions" name="Sepa Debit Subscriptions">
    <ul class="list-group">
      <li t-foreach="products" t-as="product" class="list-group-item">
        <t t-out="product.id" /> - <t t-out="product.name" /> - <a
                    t-attf-href="{{request.httprequest.url}}/product/{{product.id}}"
                >Choose</a>
      </li>
    </ul>
  </template>

  <template id="sepa_debit_subscription_cart" inherit_id="website_sale.cart">
      <xpath expr="//a[@href='/shop']" position="attributes">
        <attribute name="t-if">False</attribute>
      </xpath>
      <xpath expr="//a[@href='/shop']" position="after">
        <a role="button" href="/shop" class="btn btn-secondary mb32">
          <t t-if="website_sale_order.is_sepa_dd_payment">
              <span class="fa fa-chevron-left" />
              <span>Clear cart
                  <span class="d-none d-md-inline">and continue Shopping</span>
              </span>
          </t>
          <t t-else="">
              <span class="fa fa-chevron-left" />
              <span>Continue<span class="d-none d-md-inline"> Shopping</span></span>
          </t>
        </a>
      </xpath>
  </template>

  <template
        id="sepa_debit_subscription_cart_lines"
        inherit_id="website_sale.cart_lines"
    >
      <xpath expr="//t[@t-set='show_qty']" position="after">
        <t t-set="show_qty" t-value="not website_sale_order.is_sepa_dd_payment" />
      </xpath>
  </template>

  <template id="sepa_debit_subscription_payment" inherit_id="website_sale.payment">
      <xpath expr="//t[@name='website_sale_non_free_cart']" position="before">

        <div id="payment_method_sepa_dd" class="mt-3">
          <h3 class="mb24">Pay by SEPA Direct Debit</h3>
          <div t-if="website_sale_order.is_sepa_dd_payment">
            <form name="o_wsale_pay_by_sepa_dd" action="/shop/payment" method="post">
              <input
                            type="hidden"
                            name="csrf_token"
                            t-att-value="request.csrf_token()"
                            t-nocache="The csrf token must always be up to date."
                        />

              <div class="mb-3">
                <label for="iban" class="form-label">IBAN</label>
                <input type="text" class="form-control" id="iban" />
              </div>

              <div class="form-check mb-3">
                <input
                                class="form-check-input"
                                type="checkbox"
                                value="sign_sepa_dd"
                                id="sign-sepa-dd"
                            />
                <label class="form-check-label" for="sign-sepa-dd">
                  SEPA Direct Debit Conditions
                </label>
              </div>

              <div class="float-end mt-2">
                  <button
                                name="o_payment_submit_button_sepa_dd"
                                type="submit"
                                class="btn btn-primary"
                            >
                    Pay by SEPA Direct Debit <span class="fa fa-chevron-right" />
                  </button>
              </div>
            </form>
          </div>
          <div t-else="">
            Payment by SEPA Direct Debit is not allowed for all the product in your order.
          </div>
          <div class="clearfix" />
        </div>

      </xpath>

      <xpath expr="//form[@name='o_wsale_confirm_order']" position="attributes">
        <attribute name="t-if">not website_sale_order.is_sepa_dd_payment</attribute>
      </xpath>
  </template>

</odoo>
